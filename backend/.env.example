DATABASE_URL=postgresql://unc:unc@localhost:5432/unc_ssl
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# REQUIRED before real issuance: a real, reachable mailbox on a domain with a
# valid public-suffix TLD. Let's Encrypt rejects reserved TLDs (.example,
# .test, .invalid) with an invalidContact error, and uses this address for
# certificate expiry notices.
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CONTACT_EMAIL=certificates@your-real-domain.com

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.example
SMTP_USE_TLS=true

FRONTEND_BASE_URL=http://localhost:3000

# --- UNC chain (dummy testnet placeholders — replace once real values exist) ---
UNC_RPC_URL=https://testnet-rpc.unc-chain.example
UNC_CHAIN_ID=977001
UNC_CHAIN_NAME=UNC Testnet
UNC_NATIVE_SYMBOL=UNC
UNC_DECIMALS=18
UNC_BLOCK_EXPLORER_URL=https://testnet-explorer.unc-chain.example
UNC_TREASURY_ADDRESS=0x1234567890123456789012345678901234567890
UNC_CERT_PRICE=5.0
UNC_MIN_BALANCE_FOR_FREE=1000.0
UNC_MIN_CONFIRMATIONS=1

# Master switch for the pay-per-certificate / free-for-holders gate.
# false = every certificate is free for everyone, no wallet or payment
# required (current default — UNC's real chain isn't live yet). Set to
# true once you want payment actually enforced again.
UNC_PAYMENTS_ENABLED=false
